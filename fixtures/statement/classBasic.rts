class Counter {
  n: number
  constructor(start: number) { this.n = start }
  inc(): number { this.n = this.n + 1; return this.n }
}
let c = new Counter(10)
console.log(c.inc())
console.log(c.inc())

class Point {
  x: number
  y: number
  constructor(x: number, y: number) { this.x = x; this.y = y }
  sum(): number { return this.x + this.y }
}
let p = new Point(3, 4)
console.log(p.sum())
